import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;
import 'dart:convert';

void main() => runApp(const MyApp());

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Excelerate Forms',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        useMaterial3: true,
        scaffoldBackgroundColor: const Color(0xFFFFF9F6),
        colorScheme: ColorScheme.fromSeed(seedColor: const Color(0xFFF27038)),
      ),
      home: const FormsHubScreen(),
    );
  }
}

class AppColors {
  static const orange = Color(0xFFF27038);
  static const pink = Color(0xFFD9387B);
  static const bg = Color(0xFFFFF9F6);
  static const card = Color(0xFFFFFFFF);
  static const text = Color(0xFF2B2B33);
  static const gradient = LinearGradient(
    colors: [orange, Color(0xFFE84E59), pink],
    begin: Alignment.centerLeft,
    end: Alignment.centerRight,
  );
}

class FormsHubScreen extends StatefulWidget {
  const FormsHubScreen({super.key});

  @override
  State<FormsHubScreen> createState() => _FormsHubScreenState();
}

class _FormsHubScreenState extends State<FormsHubScreen> {
  int _selectedTab = 0;

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: AppColors.bg,
      appBar: AppBar(
        title: Text(
          _selectedTab == 0 ? 'Registration Form' : 'Feedback Form',
          style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold),
        ),
        flexibleSpace: Container(decoration: const BoxDecoration(gradient: AppColors.gradient)),
        centerTitle: true,
      ),
      body: Column(
        children: [
          // Tab Switcher
          Padding(
            padding: const EdgeInsets.all(16.0),
            child: Row(
              children: [
                Expanded(
                  child: ElevatedButton(
                    style: ElevatedButton.styleFrom(
                      backgroundColor: _selectedTab == 0 ? AppColors.pink : AppColors.card,
                      foregroundColor: _selectedTab == 0 ? Colors.white : AppColors.text,
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
                    ),
                    onPressed: () => setState(() => _selectedTab = 0),
                    child: const Text('Registration', style: TextStyle(fontWeight: FontWeight.bold)),
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: ElevatedButton(
                    style: ElevatedButton.styleFrom(
                      backgroundColor: _selectedTab == 1 ? AppColors.pink : AppColors.card,
                      foregroundColor: _selectedTab == 1 ? Colors.white : AppColors.text,
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
                    ),
                    onPressed: () => setState(() => _selectedTab = 1),
                    child: const Text('Feedback', style: TextStyle(fontWeight: FontWeight.bold)),
                  ),
                ),
              ],
            ),
          ),
          // Form Content
          Expanded(
            child: _selectedTab == 0 ? const RegistrationFormView() : const FeedbackFormView(),
          ),
        ],
      ),
    );
  }
}

// --- REGISTRATION FORM VIEW ---
class RegistrationFormView extends StatefulWidget {
  const RegistrationFormView({super.key});

  @override
  State<RegistrationFormView> createState() => _RegistrationFormViewState();
}

class _RegistrationFormViewState extends State<RegistrationFormView> {
  final _formKey = GlobalKey<FormState>();
  final _nameController = TextEditingController(text: 'Alex Smith');
  final _emailController = TextEditingController(text: 'alexis@gmail.com');
  final _phoneController = TextEditingController();
  
  String? _selectedExperience;
  final List<String> _experienceLevels = ['Beginner', 'Intermediate', 'Advanced'];
  bool _isLoading = false;

  @override
  void dispose() {
    _nameController.dispose();
    _emailController.dispose();
    _phoneController.dispose();
    super.dispose();
  }

  Future<void> _submitRegistration() async {
    if (_formKey.currentState!.validate()) {
      setState(() => _isLoading = true);

      try {
        final url = Uri.parse('https://6adc37259cae184827ad0d2b.mockapi.io/api/v1/programs');
        final response = await http.post(
          url,
          headers: {'Content-Type': 'application/json; charset=UTF-8'},
          body: jsonEncode({
            'title': 'Registration: ${_nameController.text.trim()}',
            'date': DateTime.now().toString(),
            'category': _selectedExperience ?? 'General',
            'provider': 'Excelerate User Registration',
            'description': 'Email: ${_emailController.text.trim()}, Phone: ${_phoneController.text.trim()}',
            'schedule': 'Standard',
            'eligibility': [_selectedExperience ?? 'Open'],
          }),
        );

        setState(() => _isLoading = false);
        if (!mounted) return;

        if (response.statusCode == 200 || response.statusCode == 201) {
          showDialog(
            context: context,
            builder: (ctx) => AlertDialog(
              title: const Text('Registration Successful!'),
              content: const Text('Your registration has been successfully posted to the API.'),
              actions: [
                TextButton(
                  onPressed: () {
                    Navigator.pop(ctx);
                    _formKey.currentState!.reset();
                    _phoneController.clear();
                    setState(() => _selectedExperience = null);
                  },
                  child: const Text('OK', style: TextStyle(color: AppColors.orange)),
                ),
              ],
            ),
          );
        } else {
          throw Exception('Failed with status: ${response.statusCode}');
        }
      } catch (e) {
        setState(() => _isLoading = false);
        if (!mounted) return;
        showDialog(
          context: context,
          builder: (ctx) => AlertDialog(
            title: const Text('Error'),
            content: Text('Could not submit form:\n$e'),
            actions: [
              TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('OK', style: TextStyle(color: AppColors.orange))),
            ],
          ),
        );
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Form(
        key: _formKey,
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text('Full Name', style: TextStyle(fontWeight: FontWeight.bold, color: AppColors.text)),
            const SizedBox(height: 6),
            TextFormField(
              controller: _nameController,
              decoration: InputDecoration(
                filled: true,
                fillColor: AppColors.card,
                hintText: 'Enter your full name',
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(10), borderSide: BorderSide.none),
              ),
              validator: (val) => val == null || val.isEmpty ? 'Please enter your full name' : null,
            ),
            const SizedBox(height: 16),
            const Text('Email Address', style: TextStyle(fontWeight: FontWeight.bold, color: AppColors.text)),
            const SizedBox(height: 6),
            TextFormField(
              controller: _emailController,
              keyboardType: TextInputType.emailAddress,
              decoration: InputDecoration(
                filled: true,
                fillColor: AppColors.card,
                hintText: 'Enter your email',
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(10), borderSide: BorderSide.none),
              ),
              validator: (val) {
                if (val == null || val.isEmpty) return 'Please enter your email';
                if (!val.contains('@')) return 'Enter a valid email address';
                return null;
              },
            ),
            const SizedBox(height: 16),
            const Text('Phone Number', style: TextStyle(fontWeight: FontWeight.bold, color: AppColors.text)),
            const SizedBox(height: 6),
            TextFormField(
              controller: _phoneController,
              keyboardType: TextInputType.phone,
              decoration: InputDecoration(
                filled: true,
                fillColor: AppColors.card,
                hintText: 'Enter your phone number',
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(10), borderSide: BorderSide.none),
              ),
              validator: (val) => val == null || val.length < 7 ? 'Enter a valid phone number' : null,
            ),
            const SizedBox(height: 16),
            const Text('Experience Level', style: TextStyle(fontWeight: FontWeight.bold, color: AppColors.text)),
            const SizedBox(height: 6),
            DropdownButtonFormField<String>(
              value: _selectedExperience,
              hint: const Text('Select your experience level'),
              decoration: InputDecoration(
                filled: true,
                fillColor: AppColors.card,
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(10), borderSide: BorderSide.none),
              ),
              items: _experienceLevels.map((lvl) => DropdownMenuItem(value: lvl, child: Text(lvl))).toList(),
              onChanged: (val) => setState(() => _selectedExperience = val),
              validator: (val) => val == null ? 'Please select an experience level' : null,
            ),
            const SizedBox(height: 30),
            SizedBox(
              width: double.infinity,
              child: Container(
                decoration: BoxDecoration(gradient: AppColors.gradient, borderRadius: BorderRadius.circular(12)),
                child: ElevatedButton(
                  style: ElevatedButton.styleFrom(backgroundColor: Colors.transparent, shadowColor: Colors.transparent, padding: const EdgeInsets.symmetric(vertical: 16)),
                  onPressed: _isLoading ? null : _submitRegistration,
                  child: _isLoading
                      ? const SizedBox(height: 20, width: 20, child: CircularProgressIndicator(color: Colors.white, strokeWidth: 2))
                      : const Text('Submit Registration', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 16)),
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

// --- FEEDBACK FORM VIEW ---
class FeedbackFormView extends StatefulWidget {
  const FeedbackFormView({super.key});

  @override
  State<FeedbackFormView> createState() => _FeedbackFormViewState();
}

class _FeedbackFormViewState extends State<FeedbackFormView> {
  final _formKey = GlobalKey<FormState>();
  final _feedbackController = TextEditingController();
  
  String? _selectedRating;
  final List<String> _ratings = ['Excellent (5/5)', 'Good (4/5)', 'Average (3/5)', 'Poor (1-2/5)'];
  bool _isLoading = false;

  @override
  void dispose() {
    _feedbackController.dispose();
    super.dispose();
  }

  Future<void> _submitFeedback() async {
    if (_formKey.currentState!.validate()) {
      setState(() => _isLoading = true);

      try {
        final url = Uri.parse('https://6adc37259cae184827ad0d2b.mockapi.io/api/v1/programs');
        final response = await http.post(
          url,
          headers: {'Content-Type': 'application/json; charset=UTF-8'},
          body: jsonEncode({
            'title': 'Feedback: ${_selectedRating ?? "General"}',
            'date': DateTime.now().toString(),
            'category': 'Feedback',
            'provider': 'Alex Smith (alexis@gmail.com)',
            'description': _feedbackController.text.trim(),
            'schedule': 'N/A',
            'eligibility': ['Submitted'],
          }),
        );

        setState(() => _isLoading = false);
        if (!mounted) return;

        if (response.statusCode == 200 || response.statusCode == 201) {
          showDialog(
            context: context,
            builder: (ctx) => AlertDialog(
              title: const Text('Feedback Submitted!'),
              content: const Text('Thank you for sharing your feedback with us.'),
              actions: [
                TextButton(
                  onPressed: () {
                    Navigator.pop(ctx);
                    _formKey.currentState!.reset();
                    _feedbackController.clear();
                    setState(() => _selectedRating = null);
                  },
                  child: const Text('OK', style: TextStyle(color: AppColors.orange)),
                ),
              ],
            ),
          );
        } else {
          throw Exception('Failed with status: ${response.statusCode}');
        }
      } catch (e) {
        setState(() => _isLoading = false);
        if (!mounted) return;
        showDialog(
          context: context,
          builder: (ctx) => AlertDialog(
            title: const Text('Error'),
            content: Text('Could not submit feedback:\n$e'),
            actions: [
              TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('OK', style: TextStyle(color: AppColors.orange))),
            ],
          ),
        );
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Form(
        key: _formKey,
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text('Rating / Satisfaction', style: TextStyle(fontWeight: FontWeight.bold, color: AppColors.text)),
            const SizedBox(height: 6),
            DropdownButtonFormField<String>(
              value: _selectedRating,
              hint: const Text('Select your rating'),
              decoration: InputDecoration(
                filled: true,
                fillColor: AppColors.card,
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(10), borderSide: BorderSide.none),
              ),
              items: _ratings.map((r) => DropdownMenuItem(value: r, child: Text(r))).toList(),
              onChanged: (val) => setState(() => _selectedRating = val),
              validator: (val) => val == null ? 'Please select a rating' : null,
            ),
            const SizedBox(height: 16),
            const Text('Your Comments', style: TextStyle(fontWeight: FontWeight.bold, color: AppColors.text)),
            const SizedBox(height: 6),
            TextFormField(
              controller: _feedbackController,
              maxLines: 4,
              decoration: InputDecoration(
                filled: true,
                fillColor: AppColors.card,
                hintText: 'Write your feedback or comments here...',
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(10), borderSide: BorderSide.none),
              ),
              validator: (val) => val == null || val.isEmpty ? 'Please enter your feedback comments' : null,
            ),
            const SizedBox(height: 30),
            SizedBox(
              width: double.infinity,
              child: Container(
                decoration: BoxDecoration(gradient: AppColors.gradient, borderRadius: BorderRadius.circular(12)),
                child: ElevatedButton(
                  style: ElevatedButton.styleFrom(backgroundColor: Colors.transparent, shadowColor: Colors.transparent, padding: const EdgeInsets.symmetric(vertical: 16)),
                  onPressed: _isLoading ? null : _submitFeedback,
                  child: _isLoading
                      ? const SizedBox(height: 20, width: 20, child: CircularProgressIndicator(color: Colors.white, strokeWidth: 2))
                      : const Text('Submit Feedback', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 16)),
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

